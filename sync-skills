#!/bin/bash

set -u

command_name=${0##*/}
dry_run=0
created=0
updated=0
correct=0
removed=0
conflicts=0
errors=0

case "$command_name" in
    sync-agents) targets=(.agents) ;;
    sync-claude) targets=(.claude) ;;
    sync-skills) targets=(.agents .claude) ;;
    *)
        printf 'Run this script as sync-agents, sync-claude, or sync-skills.\n' >&2
        exit 2
        ;;
esac

case "${1:-}" in
    '') ;;
    --dry-run) dry_run=1 ;;
    -h|--help)
        printf 'Usage: %s [--dry-run]\n' "$command_name"
        exit 0
        ;;
    *)
        printf 'Unknown option: %s\n' "$1" >&2
        exit 2
        ;;
esac

if (( $# > 1 )); then
    printf 'Usage: %s [--dry-run]\n' "$command_name" >&2
    exit 2
fi

show_link() {
    printf '%s: %q -> %q\n' "$1" "$2" "$3"
}

summary() {
    if (( dry_run )); then
        printf '\nSummary (dry run):\n'
    else
        printf '\nSummary:\n'
    fi
    printf '  Created: %d\n' "$created"
    printf '  Updated: %d\n' "$updated"
    printf '  Already correct: %d\n' "$correct"
    printf '  Removed: %d\n' "$removed"
    printf '  Conflicts: %d\n' "$conflicts"
    printf '  Errors: %d\n' "$errors"
}

link_destination() {
    local link=$1 raw parent leaf

    link_target_is_resolved=0
    raw=$(readlink "$link") || return 1
    if [[ "$raw" != /* ]]; then
        raw="$(cd -P "$(dirname "$link")" && pwd -P)/$raw"
    fi
    parent=${raw%/*}
    leaf=${raw##*/}
    if [[ -d "$parent" ]]; then
        parent=$(cd -P "$parent" && pwd -P) || return 1
        link_target_is_resolved=1
    fi
    link_target=$parent/$leaf
}

if [[ -z "${HOME:-}" || "$HOME" != /* || ! -d "$HOME" ]]; then
    printf 'Error: HOME must be an existing absolute directory.\n' >&2
    errors=1
    summary
    exit 1
fi

script_path=${BASH_SOURCE[0]}
while [[ -L "$script_path" ]]; do
    script_dir=$(cd -P "$(dirname "$script_path")" && pwd -P) || exit 1
    script_path=$(readlink "$script_path") || exit 1
    [[ "$script_path" == /* ]] || script_path=$script_dir/$script_path
done
repo_root=$(cd -P "$(dirname "$script_path")" && pwd -P) || {
    printf 'Error: could not resolve the repository root.\n' >&2
    errors=1
    summary
    exit 1
}

shopt -s dotglob nullglob

sync_target() {
    local target_root skill name link

    target_root=$HOME/$1/skills
    printf '\nSyncing %q\n' "$target_root"

    if [[ -L "$target_root" ]]; then
        printf 'Error: target directory is itself a symbolic link: %q\n' "$target_root" >&2
        errors=$((errors + 1))
        return
    fi
    if [[ -e "$target_root" && ! -d "$target_root" ]]; then
        printf 'Error: target path is not a directory: %q\n' "$target_root" >&2
        errors=$((errors + 1))
        return
    fi
    if [[ ! -d "$target_root" ]]; then
        if (( dry_run )); then
            printf 'Would create directory: %q\n' "$target_root"
        elif ! mkdir -p "$target_root"; then
            printf 'Error: could not create directory: %q\n' "$target_root" >&2
            errors=$((errors + 1))
            return
        fi
    fi

    for skill in "$repo_root"/*; do
        [[ -d "$skill" && -f "$skill/SKILL.md" ]] || continue

        name=${skill##*/}
        link=$target_root/$name

        if [[ -L "$link" ]]; then
            if ! link_destination "$link"; then
                printf 'Error: could not read link: %q\n' "$link" >&2
                errors=$((errors + 1))
            elif [[ "$link_target" == "$skill" ]]; then
                correct=$((correct + 1))
                show_link 'Already correct' "$link" "$skill"
            elif (( dry_run )); then
                updated=$((updated + 1))
                show_link 'Would update' "$link" "$skill"
            elif rm "$link" && ln -s "$skill" "$link"; then
                updated=$((updated + 1))
                show_link 'Updated' "$link" "$skill"
            else
                printf 'Error: could not update link: %q\n' "$link" >&2
                errors=$((errors + 1))
            fi
        elif [[ -e "$link" ]]; then
            conflicts=$((conflicts + 1))
            printf 'Conflict: real path left unchanged: %q\n' "$link"
        elif (( dry_run )); then
            created=$((created + 1))
            show_link 'Would create' "$link" "$skill"
        elif ln -s "$skill" "$link"; then
            created=$((created + 1))
            show_link 'Created' "$link" "$skill"
        else
            printf 'Error: could not create link: %q\n' "$link" >&2
            errors=$((errors + 1))
        fi
    done

    [[ -d "$target_root" ]] || return
    for link in "$target_root"/*; do
        [[ -L "$link" ]] || continue

        name=${link##*/}
        [[ -f "$repo_root/$name/SKILL.md" ]] && continue
        if ! link_destination "$link"; then
            printf 'Error: could not read link: %q\n' "$link" >&2
            errors=$((errors + 1))
            continue
        fi
        (( link_target_is_resolved )) || continue
        case "$link_target" in
            "$repo_root"/*)
                if (( dry_run )); then
                    removed=$((removed + 1))
                    show_link 'Would remove' "$link" "$link_target"
                elif rm "$link"; then
                    removed=$((removed + 1))
                    show_link 'Removed' "$link" "$link_target"
                else
                    printf 'Error: could not remove link: %q\n' "$link" >&2
                    errors=$((errors + 1))
                fi
                ;;
        esac
    done
}

for target in "${targets[@]}"; do
    sync_target "$target"
done

summary
(( conflicts == 0 && errors == 0 ))
